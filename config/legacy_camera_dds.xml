<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>camera_udp</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>camera_shm</transport_id>
        <type>SHM</type>
        <!-- Native 1080p BGRA exceeds Foxy's default 512 KiB segment. -->
        <segment_size>67108864</segment_size>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="legacy_camera" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>camera_udp</transport_id>
          <transport_id>camera_shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>

<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>camera_udp</transport_id>
        <type>UDPv4</type>
        <!-- Same as the boat's fastdds.xml: no IP-fragmented 64 KB datagrams. -->
        <maxMessageSize>1400</maxMessageSize>
        <!-- Off-host camera subscribers would otherwise get 208 KiB sockets. -->
        <receiveBufferSize>4194304</receiveBufferSize>
      </transport_descriptor>
      <transport_descriptor>
        <transport_id>camera_shm</transport_id>
        <type>SHM</type>
        <!-- Native-size camera frames exceed the default 512 KiB shared-memory segment. -->
        <segment_size>67108864</segment_size>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="camera" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>camera_udp</transport_id>
          <transport_id>camera_shm</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>
  </profiles>
</dds>

<?xml version="1.0"?>
<robot name="blastoise" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find mhseals_nav)/description/blastoise/t200_thruster.xacro"/>
  <xacro:property name="mesh_root" value="package://mhseals_nav/description/blastoise/meshes"/>

  <!-- ================= SENSOR MOUNTS =================
       The one place the sensor poses live; every joint below and every consumer (TF, the sims)
       reads them from here. Taped by the owner on 2026-11-01 (about +-13 mm) from the mount
       datum: the centre of the electrical box's bottom face, which is level with the flat hull
       tops and the rail's foot. In the CAD that plane is z -0.0126 in base_link (hull and
       cross-bar tops), and the box centre is within 2 mm of base_link in x and y.
       xyz in m from the datum (REP-103: x forward, y to port, z up); rpy in rad, 0 until the
       pre-run calibration estimates the 0-5 degree tilts of the box, the rail and the lidar. -->
  <xacro:property name="datum_z" value="-0.0126"/>
  <!-- Sensor rail: its foot on the datum plane, under the lidar. Tilting it tilts lidar and camera. -->
  <xacro:property name="rail_x" value="0.2921"/>
  <xacro:property name="rail_y" value="0.0"/>
  <xacro:property name="rail_rpy" value="0 0 0"/>
  <!-- VLP-16 centre (lidar_link, its optical centre within 2 mm) -->
  <xacro:property name="lidar_x" value="0.2921"/>
  <xacro:property name="lidar_y" value="0.0"/>
  <xacro:property name="lidar_z" value="0.2477"/>
  <xacro:property name="lidar_rpy" value="0 0 0"/>
  <!-- ZED 2i: the centre of its body as taped, and the body's depth and height (175 x 30 x 43 mm).
       front_camera_link is the ZED wrapper's camera_link (its mount point), under which the
       wrapper hangs the lens frames at (-0.01, +-0.06, height/2); it is placed so that the
       lens frame lands half a body depth ahead of the body centre. -->
  <xacro:property name="camera_x" value="0.4001"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.1397"/>
  <xacro:property name="camera_rpy" value="0 0 0"/>
  <xacro:property name="zed_depth" value="0.0431"/>
  <xacro:property name="zed_height" value="0.0303"/>
  <xacro:property name="zed_lens_x" value="-0.01"/>
  <!-- Electrical box: its tilt carries the Cube and the Here4 -->
  <xacro:property name="box_rpy" value="0 0 0"/>
  <!-- Here4 antenna and CubeOrange+ (its IMUs). The owner's x words were ambiguous: this reads
       the antenna 2.75 in forward and the Cube 2.25 in aft, as the 10-25 tape had them. -->
  <xacro:property name="gps_x" value="0.0699"/>
  <xacro:property name="gps_y" value="-0.1207"/>
  <xacro:property name="gps_z" value="0.1080"/>
  <xacro:property name="imu_x" value="-0.0572"/>
  <xacro:property name="imu_y" value="-0.1016"/>
  <xacro:property name="imu_z" value="0.1080"/>

  <!-- base_link is REP-103: x forward, y to port, z up. The meshes and the hull links are
       in the CAD's axes (x to starboard, y forward), so they are yawed -90 degrees here;
       sensor frames stay aligned with base_link. -->
  <!-- ================= BASE ================= -->
  <link name="base_link">
    <collision name="cross_bar_collision">
      <origin xyz="0 0 -0.01909" rpy="0 0 0"/>
      <geometry><box size="0.63446 0.43826 0.02435"/></geometry>
    </collision>

    <collision name="ee_box_collision">
      <origin xyz="0 0 0.06988" rpy="0 0 0"/>
      <geometry><box size="0.50929 0.43980 0.17333"/></geometry>
    </collision>

    <collision name="head_collision">
      <origin xyz="-0.36901 0 0.00696" rpy="0 0 0"/>
      <geometry><box size="0.18120 0.18120 0.18120"/></geometry>
    </collision>

    <!-- Mass and CoM are NOT measured: the boat has not been weighed. The links add up to
         crane_ml's 30 kg "loaded" (deck, electronics and batteries 10 kg here, hulls 9 kg each,
         mount 0.3, thrusters 4 x 0.427) with the CoM under base_link (x, y); each tensor is the
         solid box (or cylinder) of its link, so the composite yaw inertia is about 4.5 kg m^2. Only TF reads
         this file at runtime; replace the numbers once the boat is weighed and balanced. -->
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.195" ixy="0" ixz="0"
               iyy="0.364" iyz="0"
               izz="0.492"/>
    </inertial>

    <visual>
      <origin xyz="-0.33878 -0.24219 0.08816" rpy="1.57080 0 -1.57080"/>
      <geometry><mesh filename="${mesh_root}/bullet.stl"/></geometry>
      <material name="Material.016"/>
    </visual>

    <visual>
      <origin xyz="-0.13753 -0.00423 0.00871" rpy="1.57080 0 -1.57080"/>
      <geometry><mesh filename="${mesh_root}/cross_bar.stl"/></geometry>
      <material name="Material.020"/>
    </visual>

    <visual>
      <origin xyz="-0.00221 0.00358 0.07948" rpy="1.57080 0 -1.57080"/>
      <geometry><mesh filename="${mesh_root}/ee_box.stl"/></geometry>
      <material name="Material.008"/>
    </visual>
  </link>

  <!-- ================= HULLS ================= -->
  <link name="left_hull_link">
    <collision>
      <origin xyz="0 0 -0.07237" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_root}/left_hull_simplified.stl"
              scale="0.001 0.001 0.00081"/>
      </geometry>
    </collision>

    <inertial>  <!-- 1.06 m long (link y), 0.16 m wide, 0.2 m deep slender box -->
      <mass value="9.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.873" ixy="0" ixz="0"
               iyy="0.049" iyz="0"
               izz="0.862"/>
    </inertial>

    <visual>
      <origin xyz="0.00008 -0.04829 -0.16312" rpy="1.57080 0 0"/>
      <geometry><mesh filename="${mesh_root}/left_hull.stl"/></geometry>
      <material name="Material.006"/>
    </visual>
  </link>

  <joint name="left_hull_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_hull_link"/>
    <origin xyz="0 0.33020 -0.08000" rpy="0 0 -1.57080"/>
  </joint>

  <link name="right_hull_link">
    <collision>
      <origin xyz="0 0 -0.07437" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_root}/right_hull_simplified.stl"
              scale="0.001 0.001 0.00081"/>
      </geometry>
    </collision>

    <inertial>  <!-- 1.06 m long (link y), 0.16 m wide, 0.2 m deep slender box -->
      <mass value="9.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.873" ixy="0" ixz="0"
               iyy="0.049" iyz="0"
               izz="0.862"/>
    </inertial>

    <visual>
      <origin xyz="0.00005 -0.04914 -0.16498" rpy="1.57080 0 0"/>
      <geometry><mesh filename="${mesh_root}/right_hull.stl"/></geometry>
      <material name="Material.006"/>
    </visual>
  </link>

  <joint name="right_hull_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_hull_link"/>
    <origin xyz="0 -0.33020 -0.07800" rpy="0 0 -1.57080"/>
  </joint>

  <!-- ================= SENSOR MOUNT ================= -->
  <link name="sensor_mount_link">
    <collision>
      <origin xyz="0 0 0.15839" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.07246" length="0.34194"/>
      </geometry>
    </collision>

    <inertial>  <!-- the collision cylinder's centre and tensor -->
      <mass value="0.3"/>
      <origin xyz="0 0 0.15839" rpy="0 0 0"/>
      <inertia ixx="0.0033" ixy="0" ixz="0"
               iyy="0.0033" iyz="0"
               izz="0.0008"/>
    </inertial>
  </link>

  <joint name="sensor_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mount_link"/>
    <origin xyz="${rail_x} ${rail_y} ${datum_z}" rpy="${rail_rpy}"/>
  </joint>

  <!-- ================= SENSORS ================= -->
  <link name="front_camera_link">
    <visual>
      <origin xyz="${-zed_depth / 2 + zed_lens_x + 0.0016} -0.00056 ${zed_height / 2}"
              rpy="1.57080 0 -1.57080"/>
      <geometry><mesh filename="${mesh_root}/front_camera.stl"/></geometry>
      <material name="Material.005"/>
    </visual>
  </link>

  <joint name="front_camera_joint" type="fixed">
    <parent link="sensor_mount_link"/>
    <child link="front_camera_link"/>
    <origin xyz="${camera_x + zed_depth / 2 - zed_lens_x - rail_x} ${camera_y - rail_y} ${camera_z - zed_height / 2}"
            rpy="${camera_rpy}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="-0.01946 -0.00019 -0.01764" rpy="1.57080 0 -1.57080"/>
      <geometry><mesh filename="${mesh_root}/lidar.stl"/></geometry>
      <material name="Material.003"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mount_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x - rail_x} ${lidar_y - rail_y} ${lidar_z}" rpy="${lidar_rpy}"/>
  </joint>

  <!-- The electrical box's bottom-face centre, the mount datum. The FCU's GPS1_POS_* and
       INS_POS1..3_* are gps_link and imu_link in base_link, in FRD: x as is, y and z negated. -->
  <link name="box_link"/>
  <joint name="box_joint" type="fixed">
    <parent link="base_link"/>
    <child link="box_link"/>
    <origin xyz="0 0 ${datum_z}" rpy="${box_rpy}"/>
  </joint>

  <link name="gps_link"/>
  <joint name="gps_link_joint" type="fixed">
    <parent link="box_link"/>
    <child link="gps_link"/>
    <origin xyz="${gps_x} ${gps_y} ${gps_z}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed">
    <parent link="box_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}"/>
  </joint>

  <!-- ================= THRUSTERS ================= -->
  <xacro:t200_thruster name="front_left"
    parent="left_hull_link"
    xyz="-0.01287 0.26637 -0.28232"
    rpy="1.57080 0 2.35619"
    thruster_mesh="${mesh_root}/front_left_thruster.stl"
    prop_mesh="${mesh_root}/front_left_propeller.stl"/>

  <xacro:t200_thruster name="rear_left"
    parent="left_hull_link"
    xyz="-0.01277 -0.26625 -0.28232"
    rpy="1.57080 0 0.78540"
    thruster_mesh="${mesh_root}/rear_left_thruster.stl"
    prop_mesh="${mesh_root}/rear_left_propeller.stl"/>

  <xacro:t200_thruster name="front_right"
    parent="right_hull_link"
    xyz="0.01287 0.26636 -0.28432"
    rpy="1.57080 0 -2.35619"
    thruster_mesh="${mesh_root}/front_right_thruster.stl"
    prop_mesh="${mesh_root}/front_right_propeller.stl"/>

  <xacro:t200_thruster name="rear_right"
    parent="right_hull_link"
    xyz="0.01282 -0.26630 -0.28432"
    rpy="1.57080 0 -0.78540"
    thruster_mesh="${mesh_root}/rear_right_thruster.stl"
    prop_mesh="${mesh_root}/rear_right_propeller.stl"/>

  <!-- ================= MATERIALS ================= -->
  
  <material name="Material.003">
    <color rgba="0.14902 0.14902 0.14902 1.0"/>
  </material>
  
  <material name="Material.005">
    <color rgba="0.00784 0.00784 0.00784 1.0"/>
  </material>
  
  <material name="Material.006">
    <color rgba="0.01569 0.01569 0.01569 1.0"/>
  </material>
  
  <material name="Material.008">
    <color rgba="0.45882 0.45882 0.45882 1.0"/>
  </material>
  
  <material name="Material.010">
    <color rgba="0.03922 0.03922 0.03922 1.0"/>
  </material>
  
  <material name="Material.011">
    <color rgba="0.05098 0.05098 0.05098 1.0"/>
  </material>
  
  <material name="Material.012">
    <color rgba="0.00000 0.20000 0.80000 1.0"/>
  </material>
  
  <material name="Material.016">
    <color rgba="0.04314 0.04314 0.04314 1.0"/>
  </material>
  
  <material name="Material.018">
    <color rgba="0.17647 0.17647 0.17647 1.0"/>
  </material>
  
  <material name="Material.020">
    <color rgba="0.20784 0.20784 0.20784 1.0"/>
  </material>
</robot>
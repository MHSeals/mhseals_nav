<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="t200_thruster"
               params="
                 name
                 parent
                 xyz
                 rpy
                 thruster_mesh
                 prop_mesh
               ">

    <!-- Thruster body -->
    <link name="${name}_thruster_link">
      <inertial>
        <mass value="0.42700"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.00073" ixy="0" ixz="0"
          iyy="0.00073" iyz="0"
          izz="0.00056"/>
      </inertial>

      <visual>
        <material name="Thruster"/>
        <geometry>
          <mesh filename="${thruster_mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}_thruster_link_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_thruster_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Propeller (visual-only) -->
    <link name="${name}_propeller_link">
      <visual>
        <material name="Propeller"/>
        <origin xyz="0 0.00057 0"/>
        <geometry>
          <mesh filename="${prop_mesh}" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}_propeller_link_joint" type="continuous">
      <parent link="${name}_thruster_link"/>
      <child link="${name}_propeller_link"/>
      <origin xyz="0 0 -0.00299"/>
      <axis xyz="0 0 1"/>
      <limit effort="0" velocity="0"/>
    </joint>

  </xacro:macro>

</robot>
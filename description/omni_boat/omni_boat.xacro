<?xml version="1.0"?>
<robot name="omni_boat" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="t200_thruster.xacro"/>

  <xacro:property name="mesh_root"
                  value="package://mhseals_nav/description/omni_boat/meshes"/>

  <!-- ================= BASE ================= -->

  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.02680"/>
      <geometry>
        <box size="0.42126 0.36402 0.21093"/>
      </geometry>
    </collision>

    <collision>
      <origin xyz="0.00025 0.00008 -0.09151"/>
      <geometry>
        <box size="0.43525 0.45570 0.02168"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.08480" ixy="0" ixz="0"
        iyy="0.09020" iyz="0"
        izz="0.14480"/>
    </inertial>

    <visual>
      <material name="ElectricalBox"/>
      <origin xyz="0 0 -0.07877" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="${mesh_root}/IP65.stl"
              scale="0.00191 0.00190 0.00243"/>
      </geometry>
    </visual>

    <visual>
      <material name="Aluminum"/>
      <origin xyz="0 0.00008 -0.08989"/>
      <geometry>
        <mesh filename="${mesh_root}/ElectricalMountFrame.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <!-- ================= SENSOR RAIL ================= -->

  <link name="sensor_rail_link">
    <visual>
      <material name="Aluminum"/>
      <geometry>
        <box size="0.43927 0.02150 0.02150"/>
      </geometry>
    </visual>
  </link>

  <joint name="sensor_rail_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_rail_link"/>
    <origin xyz="0 0.37825 -0.09151"/>
  </joint>

  <!-- ================= SENSORS ================= -->

  <link name="gps_link">
    <visual>
      <material name="Material"/>
      <geometry>
        <mesh filename="${mesh_root}/Here3.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="gps_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0.12529 0.23439"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <link name="camera_link">
    <visual>
      <material name="Camera"/>
      <geometry>
        <mesh filename="${mesh_root}/ZED2i.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="camera_link_joint" type="fixed">
    <parent link="sensor_rail_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 -0.02610"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <material name="Lidar"/>
      <origin xyz="0.00003 -0.00061 0.03534"
              rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="${mesh_root}/VelodyneVLP16.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="lidar_link_joint" type="fixed">
    <parent link="sensor_rail_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.01075"/>
  </joint>

  <!-- ================= HULLS ================= -->

  <link name="left_hull_link">
    <visual>
      <material name="WaterproofedHull"/>
      <geometry>
        <mesh filename="${mesh_root}/OmniHull.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="left_hull_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_hull_link"/>
    <origin xyz="-0.33137 -0.00008 -0.20009"/>
  </joint>

  <link name="right_hull_link">
    <visual>
      <material name="WaterproofedHull"/>
      <geometry>
        <mesh filename="${mesh_root}/OmniHull.001.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>

  <joint name="right_hull_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_hull_link"/>
    <origin xyz="0.33137 -0.00008 -0.20009"/>
  </joint>

  <!-- ================= THRUSTERS ================= -->

  <xacro:t200_thruster
    name="front_left"
    parent="left_hull_link"
    xyz="-0.00031 0.27985 -0.20016"
    rpy="-1.5708 0 0.7854"
    thruster_mesh="${mesh_root}/T200Thruster.stl"
    prop_mesh="${mesh_root}/T200Propeller.001.stl"/>

  <xacro:t200_thruster
    name="rear_left"
    parent="left_hull_link"
    xyz="-0.00031 -0.27970 -0.20016"
    rpy="-1.5708 0 2.35619"
    thruster_mesh="${mesh_root}/T200Thruster.002.stl"
    prop_mesh="${mesh_root}/T200Propeller.002.stl"/>

  <xacro:t200_thruster
    name="front_right"
    parent="right_hull_link"
    xyz="0.00002 0.27985 -0.20016"
    rpy="-1.5708 0 -0.7854"
    thruster_mesh="${mesh_root}/T200Thruster.001.stl"
    prop_mesh="${mesh_root}/T200Propeller.stl"/>

  <xacro:t200_thruster
    name="rear_right"
    parent="right_hull_link"
    xyz="0.00002 -0.27970 -0.20016"
    rpy="-1.5708 0 -2.35619"
    thruster_mesh="${mesh_root}/T200Thruster.003.stl"
    prop_mesh="${mesh_root}/T200Propeller.003.stl"/>

  <!-- ================= MATERIALS ================= -->

  <material name="Aluminum"><color rgba="0.64 0.64 0.64 1"/></material>
  <material name="ElectricalBox"><color rgba="0.19 0.19 0.19 1"/></material>
  <material name="Thruster"><color rgba="0.0039 0.0039 0.0039 1"/></material>
  <material name="Propeller"><color rgba="0.0745 0.1725 0.8 1"/></material>
  <material name="WaterproofedHull"><color rgba="0.0667 0.0667 0.0667 1"/></material>
  <material name="Camera"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="Lidar"><color rgba="0.01 0.22 1.0 1"/></material>
  <material name="Material"><color rgba="0.02 0.02 0.02 1"/></material>

</robot>
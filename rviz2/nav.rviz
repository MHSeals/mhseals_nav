# Pool and lake navigation (astro rviz nav): top-down 10 m view following base_link; the 2D Goal Pose
# tool (G) publishes /goal_pose, so a click sends the boat; the Nav2 panel shows and cancels the goal.
Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 0
  Tree Height: 500
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
  Splitter Ratio: 0.5
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Alpha: 0.3
    Cell Size: 1
    Plane Cell Count: 20
    Reference Frame: base_link
    Color: 160; 160; 164
    Plane: XY
    Line Style:
      Value: Lines
      Line Width: 0.03
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: true
    Value: true
    Alpha: 0.5
    Color Scheme: costmap
    Draw Behind: true
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /global_costmap/costmap_updates
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: true
    Value: true
    Alpha: 0.6
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap
    Update Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/costmap_updates
    Use Timestamp: false
  - Class: rviz_default_plugins/PointCloud2
    Name: Lidar
    Enabled: true
    Value: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /points
    Style: Points
    Size (Pixels): 2
    Color Transformer: Intensity
    Decay Time: 0
    Position Transformer: XYZ
    Alpha: 1
    Selectable: false
    Use Fixed Frame: true
    Use rainbow: true
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Value: true
    Alpha: 1
    Description Source: Topic
    Description Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /robot_description
    Visual Enabled: true
    Collision Enabled: false
    TF Prefix: ''
    Update Interval: 0
  - Class: rviz_default_plugins/Polygon
    Name: Footprint
    Enabled: true
    Value: true
    Alpha: 1
    Color: 0; 255; 0
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_costmap/published_footprint
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Value: true
    Marker Scale: 0.5
    Show Arrows: false
    Show Axes: true
    Show Names: false
    Update Interval: 0
    Marker Alpha: 1
    Frame Timeout: 15
    Frames:
      All Enabled: false
      base_link:
        Value: true
      map:
        Value: true
      odom:
        Value: true
  - Class: rviz_default_plugins/Odometry
    Name: Odometry trail
    Enabled: true
    Value: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /odom/global
    Keep: 60
    Position Tolerance: 0.1
    Angle Tolerance: 0.2
    Covariance:
      Value: false
    Shape:
      Value: Arrow
      Color: 255; 25; 0
      Alpha: 0.6
      Shaft Length: 0.3
      Shaft Radius: 0.02
      Head Length: 0.1
      Head Radius: 0.05
  - Class: rviz_default_plugins/Path
    Name: Global plan
    Enabled: true
    Value: true
    Alpha: 1
    Color: 25; 120; 255
    Line Style: Billboards
    Line Width: 0.04
    Buffer Length: 1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /plan
    Pose Style: None
  - Class: rviz_default_plugins/Path
    Name: Local plan
    Enabled: true
    Value: true
    Alpha: 1
    Color: 0; 220; 220
    Line Style: Billboards
    Line Width: 0.03
    Buffer Length: 1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_plan
    Pose Style: None
  - Class: rviz_default_plugins/MarkerArray
    Name: MPPI trajectories
    Enabled: true
    Value: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trajectories
    Namespaces: {}
  - Class: rviz_default_plugins/Path
    Name: MPPI optimal
    Enabled: true
    Value: true
    Alpha: 1
    Color: 255; 0; 255
    Line Style: Billboards
    Line Width: 0.05
    Buffer Length: 1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /optimal_trajectory
    Pose Style: None
  - Class: rviz_default_plugins/Pose
    Name: Goal
    Enabled: true
    Value: true
    Alpha: 1
    Color: 255; 210; 0
    Shape: Arrow
    Shaft Length: 0.4
    Shaft Radius: 0.04
    Head Length: 0.15
    Head Radius: 0.1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/MarkerArray
    Name: Trial course
    Enabled: true
    Value: true
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /trial/course
    Namespaces: {}
  Enabled: true
  Global Options:
    Background Color: 40; 44; 52
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: nav2_rviz_plugins/GoalTool
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: base_link
      Value: TopDownOrtho (rviz_default_plugins)
      Scale: 90
      X: 0
      Y: 0
      Angle: 0
      Invert Z Axis: false
      Near Clip Distance: 0.01
    Saved: null
Window Geometry:
  Width: 1200
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Navigation 2:
    collapsed: false
